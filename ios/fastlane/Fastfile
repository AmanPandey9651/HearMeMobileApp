opt_out_usage

default_platform(:ios)

platform :ios do
  desc "Automatically code sign and upload build to TestFlight / App Store Connect"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"] || "P62A9B4S3C",
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"] || "ee73bce7-c132-4a6c-942e-ebb228885b87",
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    keychain_name = "ci_signing_keychain"
    keychain_password = "ci_temp_password"
    keychain_file = File.expand_path("~/Library/Keychains/#{keychain_name}-db")

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    resolved_keychain = File.exist?(keychain_file) ? keychain_file : File.expand_path("~/Library/Keychains/#{keychain_name}")

    cert(
      api_key: api_key,
      keychain_path: resolved_keychain,
      keychain_password: keychain_password
    )

    sigh(
      api_key: api_key,
      app_identifier: "com.harto.feelback"
    )

    profile_name = lane_context[SharedValues::SIGH_NAME] || ENV["SIGH_NAME"] || "com.harto.feelback AppStore"
    profile_uuid = lane_context[SharedValues::SIGH_UUID] || ENV["SIGH_UUID"]
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH] || Dir[File.expand_path("*.mobileprovision")].first

    UI.message("Installed Profile Name: #{profile_name} (UUID: #{profile_uuid})")

    # Ensure profile is installed in Xcode's search path
    provisioning_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    FileUtils.mkdir_p(provisioning_dir)
    if profile_path && File.exist?(profile_path)
      FileUtils.cp(profile_path, File.join(provisioning_dir, "#{profile_uuid}.mobileprovision")) if profile_uuid
      FileUtils.cp(profile_path, File.join(provisioning_dir, "#{profile_name}.mobileprovision"))
    end

    # Write explicit manual ExportOptions.plist with profile mapping
    export_plist_content = <<~XML
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
          <key>method</key>
          <string>app-store</string>
          <key>teamID</key>
          <string>H356C64625</string>
          <key>signingStyle</key>
          <string>manual</string>
          <key>signingCertificate</key>
          <string>Apple Distribution</string>
          <key>provisioningProfiles</key>
          <dict>
              <key>com.harto.feelback</key>
              <string>#{profile_name}</string>
          </dict>
          <key>stripSwiftSymbols</key>
          <true/>
      </dict>
      </plist>
    XML

    export_plist_path = File.expand_path("../ExportOptions.plist")
    File.write(export_plist_path, export_plist_content)
    File.write(File.expand_path("ExportOptions.plist"), export_plist_content)
    File.write(File.expand_path("../../ExportOptions.plist"), export_plist_content)

    UI.message("Generated ExportOptions.plist for manual signing with profile: #{profile_name}")

    build_num = ENV["BUILD_NUMBER"] || "81"
    version_name = ENV["VERSION_NAME"] || "1.2.48"

    # Build signed IPA with Flutter from project root
    begin
      sh("flutter build ipa --release --build-name=#{version_name} --build-number=#{build_num} --export-options-plist=#{export_plist_path}", chdir: "..")
    rescue => ex
      UI.important("Flutter build ipa stopped during export. Falling back to direct xcodebuild exportArchive...")
      archive_path = File.expand_path("../build/ios/archive/Runner.xcarchive")
      ipa_output_dir = File.expand_path("../build/ios/ipa")
      FileUtils.mkdir_p(ipa_output_dir)
      sh("xcodebuild -exportArchive -archivePath '#{archive_path}' -exportOptionsPlist '#{export_plist_path}' -exportPath '#{ipa_output_dir}'")
    end

    ipa_candidates = Dir[
      File.expand_path("../../build/ios/ipa/*.ipa"),
      File.expand_path("../build/ios/ipa/*.ipa"),
      File.expand_path("build/ios/ipa/*.ipa"),
      File.expand_path("../../build/ios/archive/*.ipa")
    ]
    ipa_file = ipa_candidates.first

    if ipa_file && File.exist?(ipa_file)
      UI.message("Found signed IPA at: #{ipa_file}")
      upload_to_testflight(
        api_key: api_key,
        ipa: ipa_file,
        skip_waiting_for_build_processing: true
      )
    else
      UI.user_error!("Could not find exported IPA file in build/ios/ipa/. Candidates searched: #{ipa_candidates.inspect}")
    end
  end
end
